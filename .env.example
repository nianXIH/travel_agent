# Application
APP_NAME=旅游知识库
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Data and models
DATA_DIR=./数据
HF_HOME=./models
HF_ENDPOINT=https://hf-mirror.com

# LLM (Alibaba Cloud Bailian, OpenAI compatible)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
ENRICH_WITH_LLM=false

# Embedding (BGE-m3)
# Accepts a HuggingFace repo id or a local model directory, for example:
# D:/ai_models/modelscope_cache/models/BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_FP16=true
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024

# Reranker (bge-reranker-v2-m3)
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# Retrieval
HYBRID_ENABLED=true
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RETRIEVAL_CANDIDATE_TOP_K=20
RRF_K=60
RERANK_TOP_N=5

# HyDE retrieval
HYDE_ENABLED=true
HYDE_TEMPERATURE=0.3
HYDE_MAX_TOKENS=320
HYDE_WEIGHT=0.9

# Web search MCP (Bailian EnhancedSearch / search_pro)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/EnhancedSearch/mcp
WEB_SEARCH_TOOL_NAME=search_pro
# Leave empty to reuse LLM_API_KEY.
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_TOP_K=5
WEB_SEARCH_MAX_CITATIONS=2
WEB_SEARCH_MIN_CITATIONS=1
WEB_SEARCH_WEIGHT=0.7

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=travel_chunks
MILVUS_CONSISTENCY_LEVEL=Strong

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=travel_kb

# Chat memory
CHAT_HISTORY_MAX_MESSAGES=12
CHAT_SUMMARY_TRIGGER=20

# Itinerary planning and recommendations
PLANNER_TEMPERATURE=0.4
PLANNER_MAX_TOKENS=4096
PLANNER_CONTEXT_PER_TYPE=3
PLANNER_MAX_CITATIONS=12

# Upload
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_SUFFIXES=.md,.markdown,.txt,.pdf,.docx
